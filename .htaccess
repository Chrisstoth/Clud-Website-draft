# Apache config for the IONOS web hosting: addresses, HTTPS, clean page URLs, the 404 page
# and security headers.

Options -MultiViews
RewriteEngine On
RewriteBase /

# The site's address is https://basildonswimming.org -- no www, as the old WordPress site was.
# www and the .co.uk addresses go there. None of this does anything until those domains are
# pointed at this folder in IONOS.
RewriteCond %{HTTP_HOST} ^www\.basildonswimming\.org$ [NC,OR]
RewriteCond %{HTTP_HOST} ^(www\.)?basildonswimming\.co\.uk$ [NC]
RewriteRule ^ https://basildonswimming.org%{REQUEST_URI} [L,R=301]
# SWITCH DAY: once basildonswimming.org is pointed at this folder, remove the # from the next two
# lines so the test domain (basildonswimmingclub.co.uk) sends visitors to the .org too -- and
# delete the TEMPORARY line further down.
#RewriteCond %{HTTP_HOST} ^(www\.)?basildonswimmingclub\.co\.uk$ [NC]
#RewriteRule ^ https://basildonswimming.org%{REQUEST_URI} [L,R=301]

# Always use HTTPS
RewriteCond %{HTTPS} off
# TEMPORARY: the test domain has no SSL certificate, so until switch day it stays on http.
RewriteCond %{HTTP_HOST} !^(www\.)?basildonswimmingclub\.co\.uk$ [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# /home -> /
RewriteRule ^home/?$ / [L,R=301]

# Old-style /page.html links -> clean /page
RewriteCond %{THE_REQUEST} \s/([^.?\s]+)\.html[\s?]
RewriteRule ^ /%1 [L,R=301]

# /join/ -> /join (pages use relative links, which break under a trailing slash)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [L,R=301]

# Clean URLs: /join serves join.html. No "does join.html exist" check: IONOS doesn't
# give rewrite rules the real folder path, so that check always failed there.
# Unknown names still end up on the 404 page.
RewriteRule ^([a-z0-9-]+)$ $1.html [L]

ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  # Scripts may only come from this site and the two CDNs the pages already use, and the
  # site can't be shown inside another site's frame (protects the members' area sign-in).
  # 'unsafe-inline' stays because every page has a small inline theme script.
  Header always set Content-Security-Policy "script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <Files "sw.js">
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>

AddType application/manifest+json .webmanifest
